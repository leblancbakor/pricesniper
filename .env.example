# Copy this file to `.env` and fill in real values. `.env` is gitignored, so
# your secrets never get committed.

# --- Discord alerting ---
# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_BOT_TOKEN=
# Channel ID to post alerts into. Enable Developer Mode in Discord, then
# right-click the channel and choose "Copy Channel ID".
DISCORD_CHANNEL_ID=

# --- eBay Browse API source ---
# App keyset from the eBay Developers Program (developer.ebay.com).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace to search (EBAY_NL, EBAY_DE, EBAY_GB, EBAY_US, ...).
EBAY_MARKETPLACE=EBAY_NL
# "production" for the real marketplace, "sandbox" for testing.
EBAY_ENV=production

# --- Storage ---
# Starts as SQLite; the path is created automatically.
DATABASE_URL=sqlite:///data/pricesniper.db
